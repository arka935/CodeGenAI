<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/purple_500"
        android:elevation="4dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenAI"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="OpenAI GPT"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGemini"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Google Gemini"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGrok"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Grok"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGroq"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Groq"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQwen"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Qwen"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeepSeek"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="DeepSeek"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopilot"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Copilot"
                android:textSize="16sp"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
